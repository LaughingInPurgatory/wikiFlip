# Optional reference for local CLI use.
# Dockhand: set these in the stack environment form instead
# (the compose file ships with admin/password defaults).

# Host port if you customize compose ports yourself
# WIKIFLIP_PORT=8080

WIKIFLIP_ADMIN_USER=admin
WIKIFLIP_ADMIN_PASSWORD=password

# Optional: bcrypt hash instead of plaintext password
# php -r "echo password_hash('secret', PASSWORD_DEFAULT), PHP_EOL;"
# WIKIFLIP_ADMIN_PASSWORD_HASH=$2y$12$...
